{
  "mcpServers": {
    "filesystem-governed": {
      "command": "agentmesh",
      "args": [
        "proxy",
        "--policy",
        "strict",
        "--target=npx",
        "--target=-y",
        "--target=@modelcontextprotocol/server-filesystem",
        "--target=/home/user/projects"
      ]
    },
    "shell-governed": {
      "command": "agentmesh",
      "args": [
        "proxy",
        "--policy",
        "strict",
        "--target=npx",
        "--target=-y",
        "--target=@modelcontextprotocol/server-shell"
      ]
    }
  }
}
