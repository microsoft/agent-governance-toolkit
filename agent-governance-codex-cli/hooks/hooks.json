{
  "description": "AGT governance hooks for Codex CLI. ${PLUGIN_ROOT} is expanded by Codex to this plugin's install directory at runtime.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/bin/agt-node\" \"${PLUGIN_ROOT}/hooks/session-start.mjs\"",
            "statusMessage": "AGT governance: session start",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/bin/agt-node\" \"${PLUGIN_ROOT}/hooks/user-prompt-submit.mjs\"",
            "statusMessage": "AGT governance: prompt inspection",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/bin/agt-node\" \"${PLUGIN_ROOT}/hooks/pre-tool-use.mjs\"",
            "statusMessage": "AGT governance: tool-call policy check",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
